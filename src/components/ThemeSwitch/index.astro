---
/**
 * 替换 Starlight 内置的 ThemeSelect（原生 <select>）。
 *
 * 原生 select 的弹层由操作系统绘制，点击后的焦点框、每项分隔线、选中高亮全都改不动，
 * 所以这里换成自绘下拉：触发器显示当前主题（图标 + 文字 + 箭头），点开是一个自己画的菜单。
 * 交互、存储键（starlight-theme）与 Starlight 完全一致，主题初始化脚本不受影响。
 * 默认暗色：服务端就把「深色」渲染成选中态，JS 没跑或存储不可用时也是暗色开局。
 */
---

<div class="theme-picker" data-theme-picker data-mode="dark">
  <button
    class="trigger"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="主题：深色"
    data-theme-trigger
  >
    <span class="mode mode-auto" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"
        ></path>
      </svg>
    </span>
    <span class="mode mode-light" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"
        ></path>
      </svg>
    </span>
    <span class="mode mode-dark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"
        ></path>
      </svg>
    </span>
    <span class="label" data-theme-label>深色</span>
    <svg class="caret" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 16a1 1 0 0 1-.71-.29l-6-6a1 1 0 0 1 1.42-1.42L12 13.59l5.29-5.3a1 1 0 0 1 1.42 1.42l-6 6a1 1 0 0 1-.71.29Z"
      ></path>
    </svg>
  </button>

  <div class="menu" role="menu" aria-label="主题" data-theme-menu hidden>
    <button class="item" type="button" role="menuitemradio" aria-checked="false" data-theme-value="auto">
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"
          ></path>
        </svg>
      </span>
      <span class="txt">自动</span>
      <span class="check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
    </button>
    <button class="item" type="button" role="menuitemradio" aria-checked="false" data-theme-value="light">
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"
          ></path>
        </svg>
      </span>
      <span class="txt">浅色</span>
      <span class="check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
    </button>
    <button class="item" type="button" role="menuitemradio" aria-checked="true" data-theme-value="dark">
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"
          ></path>
        </svg>
      </span>
      <span class="txt">深色</span>
      <span class="check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
    </button>
  </div>
</div>

<style>
  .theme-picker {
    position: relative;
    display: inline-flex;
    /* 移动菜单里社交图标为空时靠右站，和右侧其它控件对齐 */
    margin-inline-start: auto;
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.9375rem;
    padding: 0 0.4rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--sl-color-gray-2);
    font-size: 0.78125rem;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .trigger:hover {
    background: color-mix(in srgb, var(--sl-color-gray-1) 8%, transparent);
    color: var(--sl-color-gray-1);
  }

  /* 只有键盘操作才描边，鼠标点完不留一圈框 */
  .trigger:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  .trigger svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .trigger .caret {
    width: 0.75rem;
    height: 0.75rem;
    opacity: 0.55;
    transition: transform 0.2s ease;
  }

  .theme-picker:has([aria-expanded='true']) .caret {
    transform: rotate(180deg);
  }

  /* 触发器上只显示当前主题那枚图标，三枚都渲染好，靠 data-mode 切换 */
  .mode {
    display: none;
  }

  .theme-picker[data-mode='auto'] .mode-auto,
  .theme-picker[data-mode='light'] .mode-light,
  .theme-picker[data-mode='dark'] .mode-dark {
    display: block;
  }

  .menu {
    position: fixed;
    z-index: 9999;
    padding: 0.28rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.7rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
    animation: pickerIn 0.14s ease-out;
  }

  .menu[hidden] {
    display: none;
  }

  .item {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) 0.9rem;
    gap: 0.5rem;
    align-items: center;
    width: 100%;
    padding: 0.42rem 0.5rem;
    border: 0;
    border-radius: 0.45rem;
    background: none;
    color: var(--sl-color-gray-2);
    font-size: 0.78125rem;
    line-height: 1.2;
    text-align: start;
    cursor: pointer;
  }

  .item + .item {
    margin-top: 0.1rem;
  }

  .item:hover,
  .item:focus-visible {
    background: color-mix(in srgb, var(--sl-color-gray-1) 9%, transparent);
    color: var(--sl-color-gray-1);
    outline: none;
  }

  .item[aria-checked='true'] {
    color: var(--sl-color-text-accent);
  }

  .item svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .item .check {
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.14s ease;
  }

  .item .check svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .item[aria-checked='true'] .check {
    opacity: 1;
  }

  @keyframes pickerIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu {
      animation: none;
    }

    .trigger .caret,
    .item .check {
      transition: none;
    }
  }
</style>

<script>
  type Theme = 'auto' | 'light' | 'dark'

  const KEY = 'starlight-theme'
  const LABELS: Record<Theme, string> = { auto: '自动', light: '浅色', dark: '深色' }
  const pickers = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-picker]'))

  if (pickers.length) {
    // 菜单会被挂到 body 上，所以先把内部元素抓成引用，别指望之后还能从 root 里查到
    const instances = pickers.flatMap((root) => {
      const trigger = root.querySelector<HTMLButtonElement>('[data-theme-trigger]')
      const menu = root.querySelector<HTMLElement>('[data-theme-menu]')
      if (!trigger || !menu) return []
      const items = Array.from(menu.querySelectorAll<HTMLButtonElement>('[data-theme-value]'))
      return [{ root, trigger, menu, items }]
    })

    const mq = window.matchMedia('(prefers-color-scheme: light)')
    const systemTheme = (): 'light' | 'dark' => (mq.matches ? 'light' : 'dark')
    const resolve = (theme: Theme): 'light' | 'dark' => (theme === 'auto' ? systemTheme() : theme)

    /**
     * 读当前模式：'light' / 'dark' 是显式选择，'' 是用户主动选的「自动」。
     * 没存过（或存储不可用）一律按暗色 —— 站点默认就是暗色，
     * 不能因为系统是浅色就把首次访问的人送到亮色页面去。
     */
    const read = (): Theme => {
      let raw: string | null = null
      try {
        raw = localStorage.getItem(KEY)
      } catch {
        /* 隐私模式下拿不到，走下面的默认值 */
      }
      if (raw === 'light' || raw === 'dark') return raw
      if (raw === '') return 'auto'
      return 'dark'
    }

    /** 只更新 UI，不写存储 */
    const paint = (theme: Theme) => {
      for (const { root, trigger, items } of instances) {
        root.dataset.mode = theme
        const label = root.querySelector<HTMLElement>('[data-theme-label]')
        if (label) label.textContent = LABELS[theme]
        trigger.setAttribute('aria-label', `主题：${LABELS[theme]}`)
        for (const item of items) {
          item.setAttribute('aria-checked', String(item.dataset.themeValue === theme))
        }
      }
    }

    const setTheme = (theme: Theme) => {
      document.documentElement.dataset.theme = resolve(theme)
      try {
        localStorage.setItem(KEY, theme === 'auto' ? '' : theme)
      } catch {
        /* 存储不可用时至少本次生效 */
      }
      paint(theme)
    }

    for (const { root, trigger, menu, items } of instances) {
      let open = false

      const place = () => {
        const r = trigger.getBoundingClientRect()
        menu.style.minWidth = `${Math.max(126, Math.round(r.width))}px`
        const mw = menu.offsetWidth
        const mh = menu.offsetHeight
        const left = Math.min(Math.max(8, r.right - mw), window.innerWidth - mw - 8)
        let top = r.bottom + 6
        // 底下放不开就翻到上面
        if (top + mh > window.innerHeight - 8) top = Math.max(8, r.top - mh - 6)
        menu.style.left = `${Math.round(left)}px`
        menu.style.top = `${Math.round(top)}px`
      }

      const onViewportChange = () => {
        if (!open) return
        // 触发器被滚出视口就直接收起来，别让菜单飘在半空
        const r = trigger.getBoundingClientRect()
        if (r.bottom < 0 || r.top > window.innerHeight) close(false)
        else place()
      }

      const openMenu = () => {
        if (open) return
        // 挂到 body 上：position: fixed 才能既躲开侧边栏的 overflow 裁剪，
        // 又不会被 header / 侧栏的层级压住
        if (menu.parentElement !== document.body) document.body.append(menu)
        open = true
        menu.hidden = false
        menu.style.visibility = 'hidden'
        place()
        menu.style.visibility = ''
        trigger.setAttribute('aria-expanded', 'true')
        const active = items.find((i) => i.getAttribute('aria-checked') === 'true') ?? items[0]
        active?.focus({ preventScroll: true })
        window.addEventListener('scroll', onViewportChange, true)
        window.addEventListener('resize', onViewportChange)
      }

      const close = (refocus = false) => {
        if (!open) return
        open = false
        menu.hidden = true
        trigger.setAttribute('aria-expanded', 'false')
        window.removeEventListener('scroll', onViewportChange, true)
        window.removeEventListener('resize', onViewportChange)
        if (refocus) trigger.focus({ preventScroll: true })
      }

      trigger.addEventListener('click', () => (open ? close() : openMenu()))

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault()
          openMenu()
        }
      })

      for (const item of items) {
        item.addEventListener('click', () => {
          const value = item.dataset.themeValue as Theme | undefined
          if (value) setTheme(value)
          close(true)
        })
      }

      menu.addEventListener('keydown', (event) => {
        const index = items.indexOf(document.activeElement as HTMLButtonElement)
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault()
          const step = event.key === 'ArrowDown' ? 1 : -1
          items[(index + step + items.length) % items.length]?.focus()
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault()
          items[event.key === 'Home' ? 0 : items.length - 1]?.focus()
        } else if (event.key === 'Escape') {
          event.preventDefault()
          close(true)
        } else if (event.key === 'Tab') {
          close()
        }
      })

      // 点/点到外面就收起；pointerdown 比 click 早，不会和触发器的 toggle 打架
      document.addEventListener('pointerdown', (event) => {
        if (!open) return
        const target = event.target as Node
        if (menu.contains(target) || root.contains(target)) return
        close()
      })
    }

    // 自动模式下，系统切换深浅色要跟着走
    mq.addEventListener('change', () => {
      if (read() === 'auto') document.documentElement.dataset.theme = systemTheme()
    })

    // 多标签页之间同步
    window.addEventListener('storage', (event) => {
      if (event.key !== KEY) return
      const theme = read()
      document.documentElement.dataset.theme = resolve(theme)
      paint(theme)
    })

    const initial = read()
    // 存储不可用时 Starlight 会退回系统偏好，这里把「没选过 = 暗色」补齐
    if (initial === 'dark') document.documentElement.dataset.theme = 'dark'
    paint(initial)
  }
</script>
