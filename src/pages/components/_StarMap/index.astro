---
import styles from './styles.module.scss'
import { nodes, bgStars, totalNotes, totalStars } from './nodes'
import Sky from './Sky.astro'
import Side from './Side.astro'
import Panels from './Panels.astro'

/* 这个世界只有三块：星空（svg）、左栏（标题 + 星座索引）、详情面板。
   节点计算在 nodes.ts，相机逻辑在 scripts/camera.ts，这里只负责拼装。 */
---

<div class={`${styles.page} not-content`} id="starmap" data-focus="false">
  <Sky nodes={nodes} bgStars={bgStars} />

  <Side nodes={nodes} totalNotes={totalNotes} totalStars={totalStars} />

  <button class={styles.reset} type="button" data-reset hidden>
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M12.5 8a4.5 4.5 0 1 1-1.32-3.18M12.6 2.4v3.1h-3.1"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    返回全景
  </button>

  <Panels nodes={nodes} />
</div>

<script>
  import { mountCamera } from './scripts/camera'

  mountCamera()
</script>
