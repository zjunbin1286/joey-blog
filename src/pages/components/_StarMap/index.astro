---
import { getCollection } from 'astro:content'
import styles from './styles.module.scss'
import { constellations, WORLD, RADIUS } from './data'

/** 兼容 legacy collection 的 entry 形状 */
interface DocEntry {
  id: string
  slug?: string
  data: { title: string; sidebar?: { hidden?: boolean } }
  body?: string
}

const docs = (await getCollection('docs')) as unknown as DocEntry[]
const slugOf = (entry: DocEntry) => entry.slug ?? entry.id.replace(/\.mdx?$/, '')

/** 某专栏下的全部笔记，按文件序号排（01-、02- …） */
function articlesOf(key: string) {
  return docs
    .filter((entry) => {
      const slug = slugOf(entry)
      if (entry.data.sidebar?.hidden) return false
      if (/(^|\/)index$/.test(slug)) return false
      return slug.startsWith(`articles/${key}/`)
    })
    .sort((a, b) => slugOf(a).localeCompare(slugOf(b), 'en'))
    .map((entry) => ({ title: entry.data.title, url: `/${slugOf(entry)}/` }))
}

/** 背景散星：固定种子，保证每次构建一致，不会跳 */
let seed = 20261104
const rand = () => {
  seed = (seed * 16807) % 2147483647
  return seed / 2147483647
}
const bgStars = Array.from({ length: 170 }, () => ({
  x: rand() * WORLD.w,
  y: rand() * WORLD.h,
  r: 0.9 + rand() * 1.7,
  o: 0.14 + rand() * 0.5,
}))

const nodes = constellations.map((c, ci) => {
  const arts = articlesOf(c.key)

  const stars = c.pts.map((p, i) => {
    const len = Math.hypot(p.x, p.y) || 1
    const dx = p.x / len
    const dy = p.y / len
    const r = 4 + p.lum * 3.6
    return {
      ...p,
      r,
      absX: c.cx + p.x,
      absY: c.cy + p.y,
      art: arts[i] ?? null,
      // 星名朝星座外侧散开，避免挤在中间
      labelX: c.cx + p.x + dx * (r + 26),
      labelY: c.cy + p.y + dy * (r + 30),
      anchor: dx > 0.35 ? 'start' : dx < -0.35 ? 'end' : 'middle',
    }
  })

  // 文章比主星多出来的，挂成伴星，围在星座外圈
  const companions = arts.slice(stars.length).map((art, i) => {
    const a = (((ci * 47 + i * 71) % 360) * Math.PI) / 180
    const rr = RADIUS * (1.16 + ((ci * 29 + i * 13) % 24) / 100)
    return {
      ...art,
      absX: c.cx + Math.cos(a) * rr,
      absY: c.cy + Math.sin(a) * rr,
      r: 3.4,
    }
  })

  return { ...c, stars, companions, arts, index: ci }
})

const totalNotes = nodes.reduce((sum, n) => sum + n.arts.length, 0)
const totalStars = nodes.reduce((sum, n) => sum + n.stars.length + n.companions.length, 0)

const pad = (n: number) => String(n).padStart(2, '0')
---

<div class={`${styles.page} not-content`} id="starmap" data-focus="false">
  <svg
    id="starmap-sky"
    class={styles.sky}
    viewBox={`0 0 ${WORLD.w} ${WORLD.h}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="智慧星图：八个技术专栏按星座排布，每颗星对应一篇笔记"
  >
    <defs>
      <radialGradient id="starmap-glow">
        <stop offset="0" stop-color="var(--star-glow)" stop-opacity="0.55"></stop>
        <stop offset="0.35" stop-color="var(--star-glow)" stop-opacity="0.16"></stop>
        <stop offset="1" stop-color="var(--star-glow)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <g class={styles.bgstars} aria-hidden="true">
      {
        bgStars.map((s) => (
          <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} opacity={s.o.toFixed(2)} />
        ))
      }
    </g>

    <g id="starmap-world">
      {
        nodes.map((n) => (
          <g class={styles.cons} data-key={n.key} data-active="true" data-cx={n.cx} data-cy={n.cy}>
            <g class={styles.links} aria-hidden="true">
              {n.links.map(([a, b]) => (
                <line
                  x1={n.stars[a].absX}
                  y1={n.stars[a].absY}
                  x2={n.stars[b].absX}
                  y2={n.stars[b].absY}
                />
              ))}
            </g>

            <g class={styles.stars}>
              {n.stars.map((s) =>
                s.art ? (
                  <a class={styles.star} href={s.art.url} aria-label={`${n.cn} ${s.cn}：${s.art.title}`}>
                    <circle class={styles.glow} cx={s.absX} cy={s.absY} r={s.r * 4.4} />
                    <circle class={styles.core} cx={s.absX} cy={s.absY} r={s.r} />
                  </a>
                ) : (
                  <g class={styles.empty}>
                    <circle class={styles.ring} cx={s.absX} cy={s.absY} r={s.r + 5} />
                  </g>
                )
              )}
              {n.companions.map((s) => (
                <a
                  class={`${styles.star} ${styles.small}`}
                  href={s.url}
                  aria-label={`${n.cn} 伴星：${s.title}`}
                >
                  <circle class={styles.glow} cx={s.absX} cy={s.absY} r={s.r * 4} />
                  <circle class={styles.core} cx={s.absX} cy={s.absY} r={s.r} />
                </a>
              ))}
            </g>
          </g>
        ))
      }
    </g>

    <g id="starmap-labels" class={styles.labels} font-size="30" aria-hidden="true">
      {
        nodes.map((n) => (
          <g class={styles.consLabel} data-label={n.key}>
            <text class={styles.consName} x={n.cx} y={n.cy + RADIUS + 62} text-anchor="middle">
              {n.cn}
            </text>
            <text class={styles.latin} x={n.cx} y={n.cy + RADIUS + 88} text-anchor="middle">
              {n.latin}
            </text>
            {n.stars.map((s) => (
              <text
                class={`${styles.starName} ${s.art ? '' : styles.starNameEmpty}`}
                x={s.labelX}
                y={s.labelY}
                text-anchor={s.anchor}
                dominant-baseline="middle"
              >
                {s.cn}
              </text>
            ))}
          </g>
        ))
      }
    </g>
  </svg>

  <div class={styles.head}>
    <p class={styles.kicker}>SMART STARMAP</p>
    <h1 class={styles.title}>智慧星图</h1>
    <p class={styles.lead}>
      {nodes.length} 个专栏，{totalNotes} 篇笔记，{totalStars} 颗星。星点位置取自真实赤经赤纬，
      大小按星等。点一颗星，去看那篇笔记。
    </p>
  </div>

  <button class={styles.reset} type="button" data-reset hidden>
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M12.5 8a4.5 4.5 0 1 1-1.32-3.18M12.6 2.4v3.1h-3.1"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    返回全景
  </button>

  {
    nodes.map((n) => (
      <aside class={styles.panel} data-panel data-key={n.key} hidden>
        <div class={styles.panelTop}>
          <div>
            <h2 class={styles.panelName}>{n.cn}</h2>
            <p class={styles.panelLatin}>
              {n.latin} · {n.column}
            </p>
          </div>
          <button class={styles.close} type="button" data-close aria-label="关闭">
            ×
          </button>
        </div>
        <p class={styles.panelDesc}>{n.desc}</p>
        <p class={styles.panelCount}>
          {n.arts.length} 篇笔记 · {n.stars.length + n.companions.length} 颗星
        </p>
        <ol class={styles.arts}>
          {n.arts.map((a, i) => (
            <li>
              <a href={a.url}>
                <i>{pad(i + 1)}</i>
                <span>{a.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class={styles.more} href={`/articles/${n.key}/`}>
          进入整个专栏
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </aside>
    ))
  }

  <nav class={styles.rail} aria-label="选择星座">
    <span class={styles.railHint}>滚轮缩放 · 拖拽平移</span>
    <ul>
      {
        nodes.map((n) => (
          <li>
            <a href={`/articles/${n.key}/`} data-chip={n.key}>
              <span class={styles.chipDot} aria-hidden="true"></span>
              {n.cn}
              <em>{n.arts.length}</em>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const root = document.getElementById('starmap')
  const svg = document.getElementById('starmap-sky') as unknown as SVGSVGElement | null
  const labels = document.getElementById('starmap-labels')
  const world = document.getElementById('starmap-world')
  const resetBtn = document.querySelector('[data-reset]') as HTMLButtonElement | null

  if (root && svg && labels && world) {
    const W = Number.parseFloat(svg.getAttribute('viewBox')!.split(/\s+/)[2])
    const H = Number.parseFloat(svg.getAttribute('viewBox')!.split(/\s+/)[3])

    type View = { x: number; y: number; w: number; h: number }

    let view: View = { x: 0, y: 0, w: W, h: H }
    let raf = 0
    let activeKey: string | null = null

    const viewport = () => {
      const rect = svg.getBoundingClientRect()
      return { w: rect.width || 1, h: rect.height || 1 }
    }

    /** 当前缩放比例（1 世界单位 = 多少屏幕像素） */
    const scaleOf = (v: View) => Math.min(viewport().w / v.w, viewport().h / v.h)

    const apply = () => {
      svg.setAttribute('viewBox', `${view.x} ${view.y} ${view.w} ${view.h}`)
      // 星座名与星名保持恒定屏幕字号，不然聚焦后会变成巨字
      const s = scaleOf(view) || 1
      labels.setAttribute('font-size', (14.5 / s).toFixed(2))
    }

    /** 初始视角：桌面装下整个世界；竖屏改成按高度铺满，靠左右拖动浏览 */
    const fit = (): View => {
      const { w: vw, h: vh } = viewport()
      const aspect = vw / vh
      if (vw < 720) {
        const w = H * aspect
        return { x: (W - w) / 2, y: 78, w, h: H }
      }
      const worldAspect = W / H
      const w = worldAspect > aspect ? W : H * aspect
      const h = w / aspect
      return { x: (W - w) / 2, y: (H - h) / 2 + 72, w, h }
    }

    /** 聚焦某个星座：让星座直径占满短边的 85%，并给右侧面板让出位置 */
    const focusOn = (cx: number, cy: number): View => {
      const { w: vw, h: vh } = viewport()
      const aspect = vw / vh
      const narrow = vw <= 960
      const w = Math.max(300, Math.min(900, (360 * vw) / (Math.min(vw, vh) * 0.85)))
      const h = w / aspect
      const shiftX = narrow ? 0 : Math.min(184, vw * 0.15) * (w / vw)
      const shiftY = narrow ? h * 0.2 : 0
      return { x: cx - w / 2 + shiftX, y: cy - h / 2 + shiftY, w, h }
    }

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2)

    const flyTo = (target: View, duration = 720) => {
      cancelAnimationFrame(raf)
      const from = { ...view }
      const start = performance.now()
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration)
        const k = ease(t)
        view = {
          x: from.x + (target.x - from.x) * k,
          y: from.y + (target.y - from.y) * k,
          w: from.w + (target.w - from.w) * k,
          h: from.h + (target.h - from.h) * k,
        }
        apply()
        if (t < 1) raf = requestAnimationFrame(step)
      }
      raf = requestAnimationFrame(step)
    }

    const setActive = (key: string | null) => {
      activeKey = key
      root.dataset.focus = key ? 'true' : 'false'
      if (resetBtn) resetBtn.hidden = !key

      world.querySelectorAll('g[data-key]').forEach((g) => {
        g.setAttribute('data-active', String(!key || g.getAttribute('data-key') === key))
      })
      document.querySelectorAll('g[data-label]').forEach((g) => {
        g.setAttribute('data-active', String(!key || g.getAttribute('data-label') === key))
      })
      document.querySelectorAll('[data-panel]').forEach((p) => {
        const el = p as HTMLElement
        el.hidden = !key || el.dataset.key !== key
      })
      document.querySelectorAll('[data-chip]').forEach((chip) => {
        chip.setAttribute('aria-current', key && chip.getAttribute('data-chip') === key ? 'true' : 'false')
      })
    }

    const spots = Array.from(world.querySelectorAll('g[data-key]')).map((g) => ({
      key: g.getAttribute('data-key')!,
      cx: Number(g.getAttribute('data-cx')),
      cy: Number(g.getAttribute('data-cy')),
    }))

    const focusKey = (key: string) => {
      const item = spots.find((c) => c.key === key)
      if (!item) return
      setActive(key)
      flyTo(focusOn(item.cx, item.cy))
    }

    const reset = () => {
      setActive(null)
      flyTo(fit())
    }

    // 芯片：默认是链接（无 JS 时直接进专栏），有 JS 时改成聚焦
    document.querySelectorAll('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', (event) => {
        event.preventDefault()
        const key = chip.getAttribute('data-chip')!
        if (activeKey === key) reset()
        else focusKey(key)
      })
    })

    document.querySelectorAll('[data-close]').forEach((btn) => {
      btn.addEventListener('click', () => reset())
    })
    resetBtn?.addEventListener('click', () => reset())

    // 点击星座名也能聚焦
    document.querySelectorAll('g[data-label]').forEach((g) => {
      const el = g as SVGElement
      el.addEventListener('click', () => focusKey(el.getAttribute('data-label')!))
      el.style.cursor = 'pointer'
    })

    // 拖拽平移 + 滚轮缩放
    let dragging = false
    let moved = 0
    let lastX = 0
    let lastY = 0

    const toWorld = (clientX: number, clientY: number) => {
      const rect = svg.getBoundingClientRect()
      const s = scaleOf(view)
      const offsetX = rect.width - view.w * s
      const offsetY = rect.height - view.h * s
      return {
        x: view.x + (clientX - rect.left - offsetX / 2) / s,
        y: view.y + (clientY - rect.top - offsetY / 2) / s,
      }
    }

    svg.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return
      dragging = true
      moved = 0
      lastX = event.clientX
      lastY = event.clientY
      svg.setPointerCapture(event.pointerId)
    })

    svg.addEventListener('pointermove', (event) => {
      if (!dragging) return
      const dx = event.clientX - lastX
      const dy = event.clientY - lastY
      moved += Math.abs(dx) + Math.abs(dy)
      lastX = event.clientX
      lastY = event.clientY
      const s = scaleOf(view)
      view = { ...view, x: view.x - dx / s, y: view.y - dy / s }
      apply()
    })

    svg.addEventListener('pointerup', () => {
      dragging = false
      // 拖拽结束时吞掉随后的 click，避免误触星点跳转
    })

    svg.addEventListener('click', (event) => {
      if (moved > 6) {
        event.preventDefault()
        event.stopPropagation()
        moved = 0
      }
    }, true)

    svg.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault()
        const before = toWorld(event.clientX, event.clientY)
        const factor = Math.exp(event.deltaY * 0.0014)
        const w = Math.min(W * 1.35, Math.max(280, view.w * factor))
        const h = w / (view.w / view.h)
        const s = Math.min(viewport().w / w, viewport().h / h)
        const rect = svg.getBoundingClientRect()
        const offsetX = rect.width - w * s
        const offsetY = rect.height - h * s
        view = {
          x: before.x - (event.clientX - rect.left - offsetX / 2) / s,
          y: before.y - (event.clientY - rect.top - offsetY / 2) / s,
          w,
          h,
        }
        apply()
      },
      { passive: false }
    )

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && activeKey) reset()
    })

    window.addEventListener('resize', () => {
      if (!activeKey) view = fit()
      apply()
    })

    view = fit()
    apply()
  }
</script>
