---
import styles from './styles.module.scss'
import NovapixLogo from '../../../components/NovapixLogo/index.astro'

interface Props {
  experience: number
  articleCount: number
  projectCount: number
  solutionCount: number
}

const { experience, articleCount, projectCount, solutionCount } = Astro.props
---

<header class={styles.hero}>
  <span class={styles.tag}>
    <i aria-hidden="true"></i>持续写作中 · 第 {experience} 年
  </span>
  <h1>
    在星图上<em>写下坐标</em>
  </h1>
  <p>
    {articleCount} 篇技术笔记、{projectCount} 个项目、{solutionCount} 份踩坑记录。
    这些不是教程，是我在这张图上留下的坐标。
  </p>
  <div class={styles.acts}>
    <a
      class={`${styles.btn} ${styles.primary}`}
      href="https://github.com/zjunbin1286"
      target="_blank"
      rel="noopener noreferrer"
    >
      前往 GitHub
      <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
    </a>
    <a class={`${styles.btn} ${styles.sky}`} href="/starmap/">
      <span class={styles.skyIco} aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
          <path d="M8 1.4 9.5 6.5 14.6 8 9.5 9.5 8 14.6 6.5 9.5 1.4 8 6.5 6.5Z" fill="currentColor"
          ></path>
        </svg>
      </span>
      <span class={styles.skyText}>前往观星台</span>
    </a>
    <a
      class={`${styles.btn} ${styles.pixel} nvp-hover`}
      href="https://novapix-ai.online/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class={styles.pixelIco}>
        <NovapixLogo size={18} />
      </span>
      <span class={styles.pixelText}>开始 AI 创作</span>
    </a>
  </div>
</header>
