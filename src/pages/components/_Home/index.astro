---
import styles from './styles.module.scss'
import { loadHomeData } from './data'
import Hero from './Hero.astro'
import Stats from './Stats.astro'
import Promo from './Promo.astro'
import LatestPosts from './LatestPosts.astro'
import ProjectGrid from './ProjectGrid.astro'
import MoreLinks from './MoreLinks.astro'
import HomeFooter from './HomeFooter.astro'

/* 数据、区块、动效各自成文件，这里只负责拼装顺序。
   加一个区块 = 写一个 .astro 再在这里插一行，不用在 600 行里找位置。 */
const home = await loadHomeData()
---

<script is:inline>
  // 在元素渲染前打标记，避免 reveal 动效出现闪动；无 JS 时内容照常可见
  document.documentElement.classList.add('home-js');
</script>

<div class={`${styles.root} not-content`} id="home-root">
  <canvas class={styles.canvas} id="home-stars" aria-hidden="true"></canvas>
  <div class={styles.veil} aria-hidden="true"></div>

  <div class={styles.inner}>
    <Hero
      experience={home.experience}
      articleCount={home.articleCount}
      projectCount={home.projectCount}
      solutionCount={home.solutionCount}
    />

    <Stats stats={home.stats} />

    <Promo />

    <LatestPosts items={home.latest} total={home.articleCount} />

    <ProjectGrid items={home.projects} total={home.projectCount} />

    <MoreLinks links={home.extraLinks} />

    <HomeFooter year={home.year} lastUpdated={home.lastUpdated} />
  </div>
</div>

<script>
  import { mountParticles } from './scripts/particles'
  import { mountReveal } from './scripts/reveal'

  mountParticles()
  mountReveal()
</script>

<style is:global>
  /* 首页铺满：清掉 Starlight splash 的内容容器留白。
     这些规则只随本组件所在页面加载，不会影响其他页面。 */
  main > .content-panel {
    padding: 0;
    border-top: 0;
  }

  main > .content-panel .sl-container {
    max-width: none;
    margin-inline: 0;
  }

  main > .content-panel .sl-container > * + * {
    margin-top: 0;
  }

  /* 首页要顶到底：清掉 Starlight markdown 容器给首元素加的外边距 */
  main > .content-panel:has(#home-root) .sl-container > #home-root,
  main > .content-panel:has(#home-root) .sl-markdown-content > #home-root {
    margin-top: 0;
    margin-bottom: 0;
  }

  /* starlight-image-zoom 是未定义的自定义元素，默认 display:inline，
     包裹首页内容时会被行高撑出空白条。 */
  main > .content-panel:has(#home-root) starlight-image-zoom {
    display: block;
  }

  /* 首页让星空顶到 fixed header 后面，磨砂导航才有内容可以透过；
     正文的nav高度补偿在 .hero 的 padding-top 里。 */
  body:has(#home-root) .main-frame {
    padding-top: 0;
  }

  /* Starlight 会给 .sl-markdown-content 里的相邻块元素补 1rem 的 margin-top，
     这条规则会一路命中首页内部的绝对定位层（canvas 后面那层 veil 被推下 16px，
     露出一条底色白条）。根节点已挂 not-content 让整棵子树退出 markdown 样式，
     这里再按 ID 兜一层，保证首页内部间距完全由组件自己决定。 */
  #home-root > * {
    margin-top: 0;
  }

  /* splash 默认还会渲染一个页面标题栏，首页由自定义 hero 承担，这里隐藏 */
  main > .content-panel:not(:has(#home-root)) {
    display: none;
  }

  /* Starlight 自带的编辑链接 / 更新时间 / 上下篇导航在首页没有意义 */
  main > .content-panel:has(#home-root) .sl-container > footer {
    display: none;
  }
</style>
